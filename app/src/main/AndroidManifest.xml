<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The point of this app: fetch an APK and hand it to the system installer. The user
         still has to allow "install unknown apps" for us; Android asks them itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MG4Browser"
        android:usesCleartextTraffic="true">
        <!-- Cleartext is allowed on purpose. Captive portals — the hotel/charger Wi-Fi login
             pages this browser exists partly to get through — are plain http by definition:
             the redirect happens before there is any working connection to secure. Refusing
             http would make the app useless for that job. -->

        <activity
            android:name=".BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <!-- adjustResize, not adjustPan: the address bar lives at the top and the system
                 IME is tall on this screen. Panning would slide the bar off the top edge
                 exactly while the user is typing in it.

                 configChanges keeps the WebView alive when the IME appears or the system
                 reports a keyboard: recreating the activity would reload the page and lose a
                 half-finished captive-portal login. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deliberately not registered as a system link handler (no BROWSABLE/VIEW
                 filter). Claiming http/https would make Android show a "choose a browser"
                 dialog elsewhere in the head unit, and this car keeps the factory launcher
                 in front for a reason. One line to add here if that ever changes. -->
        </activity>

        <!-- Serves the downloaded APK to the system installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
