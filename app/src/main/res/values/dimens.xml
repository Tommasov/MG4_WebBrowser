<?xml version="1.0" encoding="utf-8"?>
<!-- Tuned for a 1920x720 head unit read from about a metre away, in a seat, sometimes with
     the engine running. Text sizes follow MG4 Simple Launcher's vocabulary, which it read off
     the factory launcher's own layouts: title 30, body/label 28, button 26, secondary 20. -->
<resources>
    <dimen name="screen_padding">24dp</dimen>

    <!-- Toolbar. 96dp so the round buttons inside it are a target a gloved hand hits without
         aiming; the address field is the same height for the same reason. -->
    <dimen name="toolbar_height">96dp</dimen>
    <dimen name="toolbar_padding_h">16dp</dimen>
    <dimen name="toolbar_gap">8dp</dimen>
    <dimen name="toolbar_button_size">80dp</dimen>
    <dimen name="toolbar_icon_padding">18dp</dimen>

    <!-- The address bar carries body size, not button size: it is the one thing in the
         chrome that is read rather than pressed. -->
    <dimen name="address_text_size">28sp</dimen>
    <dimen name="address_padding_h">24dp</dimen>
    <dimen name="native_button_radius">10dp</dimen>

    <!-- Thicker than a phone's hairline progress bar. The car's connection is slow enough
         that "is it doing anything?" is a real question, and the answer has to carry to the
         driver's seat. -->
    <dimen name="progress_height">6dp</dimen>

    <!-- Favourites grid. The number of columns and the width of a tile are worked out at
         runtime from the screen, and this is the smallest a tile may be before a column is
         dropped instead.

         The grid used to be five fixed 340dp tiles, sized against a screen assumed to be
         1920 wide. The car reported itself on 18 September 2026: 1778x720 at 160 dpi, so a
         dp is a pixel and the row had 1730dp to live in. Five tiles each carrying a trailing
         16dp margin want 1780, so the fifth one was cut by 50dp on every MG4 — while the
         emulator, at 1920, showed it whole. A layout that only fits the machine it was
         written on is a layout that has not been written yet. -->
    <dimen name="tile_width_min">300dp</dimen>
    <dimen name="tile_height">180dp</dimen>
    <dimen name="tile_gap">16dp</dimen>
    <dimen name="tile_padding">20dp</dimen>
    <!-- The initial-letter badge. Sized between the launcher's drawer icon (88dp) and its
         favourite icon (160dp): this tile carries two lines of text beside it, that one
         carries a label underneath. -->
    <dimen name="tile_badge_size">88dp</dimen>
    <dimen name="tile_badge_text_size">44sp</dimen>
    <dimen name="tile_title_size">30sp</dimen>
    <dimen name="tile_host_size">20sp</dimen>

    <dimen name="favorites_title_size">30sp</dimen>
    <!-- The engine notice at the foot of the home screen. Reference material, not something
         to read while moving, so it sits a tier below everything else. -->
    <dimen name="footnote_size">20sp</dimen>
</resources>
